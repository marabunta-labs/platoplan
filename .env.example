# Supabase Configuration
# Get these from your Supabase project: Project Settings -> API
# (See DEPLOYMENT.md for the full setup + Vercel steps.)
#
# The EXPO_PUBLIC_ prefix is required so Expo embeds them in the web bundle.
# The anon key is public by design; security is enforced via Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
